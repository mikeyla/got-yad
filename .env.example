# Supabase Configuration for Cross-Device Play
# Copy this file to .env and add your Supabase credentials

# Get these from your Supabase project settings:
# https://app.supabase.com/project/_/settings/api

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Note: Without these variables, the game will use localStorage
# for same-browser tab sync only (players must be in same browser).
# With Supabase configured, players can join from different devices.
